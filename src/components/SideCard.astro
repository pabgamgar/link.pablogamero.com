---
import Icon from "./Icon.astro";
import type { Side } from "../config/linkpage";
import { SIDES, SIDE_ORDER, otherSide } from "../config/sides";
import { sideKey } from "../lib/i18n";

interface Props {
    active: Side;
}

const { active } = Astro.props;
const next = SIDES[otherSide(active)];
---

<button
    type="button"
    class="card-stack"
    data-side-card
    data-front={active}
    aria-label={`Switch to ${next.shortName.en}`}
    data-i18n-aria={sideKey(next.id, "switch")}
>
    {
        SIDE_ORDER.map((id) => {
            const side = SIDES[id];
            const other = SIDES[otherSide(id)];
            return (
                <span
                    class:list={["face", `face--${id}`]}
                    data-face={id}
                    data-pos={id === active ? "front" : "back"}
                    data-side-theme={id}
                    aria-hidden={id === active ? undefined : "true"}
                >
                    <span class="face-head">
                        <span class="tag">
                            <span class="tag-dot" />
                            <span data-i18n={sideKey(id, "tag")}>{side.tag.en}</span>
                        </span>
                        <span class="flip-chip">
                            <Icon name="repeat" class="size-3.5" />
                            <span data-i18n={sideKey(other.id, "short")}>
                                {other.shortName.en}
                            </span>
                        </span>
                    </span>
                    <span class="identity">
                        <img class="avatar" src={side.avatar} alt="" width="56" height="56" />
                        <span class="flex flex-col gap-1">
                            <span class="name">{side.name}</span>
                            <span class="role" data-i18n={sideKey(id, "role")}>
                                {side.role.en}
                            </span>
                        </span>
                    </span>
                    <span class="bio" data-i18n={sideKey(id, "bio")}>
                        {side.bio.en}
                    </span>
                </span>
            );
        })
    }
</button>

<style>
    /* Both cards share one grid cell. The back one sticks out underneath;
       switching shuffles them: front slides down and tucks behind, back rises. */
    .card-stack {
        position: relative;
        display: grid;
        width: 100%;
        padding-bottom: 14px;
        text-align: left;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .card-stack:focus-visible {
        outline: 2px solid #9de8d9;
        outline-offset: 4px;
        border-radius: 28px;
    }
    [data-side-theme="work"] {
        --face-from: rgb(97 204 186 / 0.24);
        --face-to: rgb(0 40 40 / 0.55);
        --face-border: rgb(157 232 217 / 0.28);
        --face-accent: #9de8d9;
        --avatar-bg: #20b8d9;
    }
    [data-side-theme="personal"] {
        --face-from: rgb(59 130 246 / 0.42);
        --face-to: rgb(10 30 70 / 0.6);
        --face-border: rgb(147 197 253 / 0.32);
        --face-accent: #bfdbfe;
        --avatar-bg: #3b82f6;
    }

    .face {
        grid-area: 1 / 1;
        transform-origin: 50% 100%;
        transition:
            transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
            filter 420ms ease;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 22px;
        border-radius: 28px;
        border: 1px solid var(--face-border);
        background: linear-gradient(135deg, var(--face-from), var(--face-to));
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.6);
    }
    .face > * {
        transition: opacity 240ms ease;
    }
    .face[data-pos="front"] {
        z-index: 2;
    }
    .face[data-pos="back"] {
        z-index: 1;
        transform: translateY(14px) scale(0.92);
        filter: brightness(0.75);
    }
    .face[data-pos="back"] > * {
        opacity: 0;
    }
    .card-stack:active .face[data-pos="front"] {
        transform: scale(0.985);
    }

    /* Shuffle. z-index flips halfway, while the cards are apart. */
    .face.is-leaving {
        animation: card-leave 560ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    .face.is-entering {
        animation: card-enter 560ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    @keyframes card-leave {
        0% {
            z-index: 2;
            transform: none;
        }
        45% {
            z-index: 2;
            transform: translateY(42%) rotate(-3deg) scale(0.96);
        }
        55% {
            z-index: 1;
        }
        100% {
            z-index: 1;
            transform: translateY(14px) scale(0.92);
        }
    }
    @keyframes card-enter {
        0% {
            z-index: 1;
            transform: translateY(14px) scale(0.92);
        }
        45% {
            z-index: 1;
            transform: translateY(-14%) rotate(2deg) scale(0.97);
        }
        55% {
            z-index: 2;
        }
        100% {
            z-index: 2;
            transform: none;
        }
    }
    .face-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .tag,
    .flip-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 26px;
        padding: 0 10px;
        border-radius: 9999px;
        background: rgb(255 255 255 / 0.1);
        font-family: ui-monospace, "Geist Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
    }
    .tag {
        text-transform: uppercase;
    }
    .tag-dot {
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: var(--face-accent);
    }
    .flip-chip {
        border: 1px solid rgb(255 255 255 / 0.14);
    }
    .identity {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .avatar {
        display: grid;
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        place-items: center;
        border-radius: 9999px;
        border: 2px solid rgb(255 255 255 / 0.25);
        background: var(--avatar-bg);
        object-fit: cover;
    }
    .name {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
    }
    .role {
        font-size: 14px;
        font-weight: 500;
        color: var(--face-accent);
    }
    .bio {
        font-size: 16px;
        line-height: 1.4;
        color: rgb(241 241 241 / 0.72);
    }

    /* Short phones: tighter card so the orbit and Save contact still fit. */
    @media (max-height: 740px) {
        .face {
            gap: 10px;
            padding: 16px 18px;
        }
        .avatar {
            width: 44px;
            height: 44px;
        }
        .name {
            font-size: 22px;
        }
        .role {
            font-size: 13px;
        }
        .bio {
            font-size: 14px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .face,
        .face > * {
            transition: none;
        }
        .face.is-leaving,
        .face.is-entering {
            animation: none;
        }
    }
</style>
