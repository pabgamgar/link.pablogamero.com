---
import Icon from "./Icon.astro";
import type { SideConfig } from "../config/linkpage";
import { moonKey, nodeKey, sideKey } from "../lib/i18n";
import { ORBIT_BOX, placeOnOrbit, polar } from "../lib/orbit";

interface Props {
    side: SideConfig;
    active: boolean;
}

const { side, active } = Astro.props;
const MOON_RADIUS = 50;
const isExternal = (href: string) => href.startsWith("http");
const moonOffset = (angle: number) => {
    const { x, y } = polar(MOON_RADIUS, angle);
    return `--mx:${x.toFixed(1)};--my:${y.toFixed(1)};`;
};
const hintDot = (angle: number) => {
    const { x, y } = polar(34, angle);
    return `left:calc(50% + ${x.toFixed(1)} * var(--u));top:calc(50% + ${y.toFixed(1)} * var(--u));`;
};
---

<div
    class="orbit"
    data-orbit={side.id}
    data-side-theme={side.id}
    aria-hidden={active ? undefined : "true"}
    inert={!active}
>
    <svg
        class="rings"
        fill="none"
        stroke="rgb(255 255 255 / 0.08)"
        stroke-width="1"
        viewBox={`0 0 ${ORBIT_BOX.width} ${ORBIT_BOX.height}`}
        aria-hidden="true"
    >
        {
            side.rings.map((r) => (
                <circle cx={ORBIT_BOX.cx} cy={ORBIT_BOX.cy} r={r} vector-effect="non-scaling-stroke" />
            ))
        }
    </svg>

    <span class="orbit-item sun-wrap" style={placeOnOrbit(0, 0)}>
        <span class="halo" aria-hidden="true"></span>
        <span class="sun">
            <Icon name={side.sun.icon} class="size-[29%]" />
            <span class="sun-label" data-i18n={sideKey(side.id, "sun")}>
                {side.sun.label.en}
            </span>
        </span>
    </span>

    {
        side.nodes.map((node) =>
            node.kind === "link" ? (
                <a
                    class="orbit-item node"
                    style={placeOnOrbit(node.radius, node.angle)}
                    data-radius={node.radius}
                    data-angle={node.angle}
                    href={node.href}
                    target={isExternal(node.href) ? "_blank" : undefined}
                    rel={isExternal(node.href) ? "noopener noreferrer" : undefined}
                >
                    <span class="chip">
                        <Icon name={node.icon} class="size-[45%]" />
                    </span>
                    <span class="node-label" data-i18n={nodeKey(side.id, node.id)}>
                        {node.label.en}
                    </span>
                </a>
            ) : (
                <div
                    class="orbit-item planet-wrap"
                    data-planet={node.id}
                    style={placeOnOrbit(node.radius, node.angle)}
                    data-radius={node.radius}
                    data-angle={node.angle}
                >
                    <span class="hint" aria-hidden="true">
                        {node.moons.map((m) => (
                            <span class="hint-dot" style={hintDot(m.angle)} />
                        ))}
                    </span>
                    <span class="moon-orbit" aria-hidden="true" />
                    <button
                        type="button"
                        class="planet"
                        aria-expanded="false"
                        aria-controls={`moons-${side.id}-${node.id}`}
                    >
                        {node.icon ? (
                            <Icon name={node.icon} class="size-[42%]" />
                        ) : (
                            <span class="planet-letter">{node.letter}</span>
                        )}
                        <span
                            class="node-label node-label--above"
                            data-i18n={nodeKey(side.id, node.id)}
                        >
                            {node.label.en}
                        </span>
                    </button>
                    <ul class="moons" id={`moons-${side.id}-${node.id}`}>
                        {node.moons.map((moon) => (
                            <li class="moon-slot" style={moonOffset(moon.angle)}>
                                <a
                                    class:list={["moon", { "moon--app": moon.appIcon }]}
                                    href={moon.href}
                                    target={isExternal(moon.href) ? "_blank" : undefined}
                                    rel={isExternal(moon.href) ? "noopener noreferrer" : undefined}
                                    tabindex="-1"
                                >
                                    {moon.appIcon ? (
                                        <img src={moon.appIcon} alt="" width="32" height="32" loading="lazy" decoding="async" />
                                    ) : moon.icon ? (
                                        <Icon name={moon.icon} class="size-1/2" />
                                    ) : null}
                                    <span
                                        class="sr-only"
                                        data-i18n={moonKey(side.id, node.id, moon.id)}
                                    >
                                        {moon.label.en}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ),
        )
    }
</div>

<style>
    .orbit {
        position: relative;
        grid-area: 1 / 1;
        width: 100%;
        aspect-ratio: 390 / 410;
        /* One design pixel: everything scales with the orbit's width. */
        --u: calc(100cqi / 390);
        transition:
            opacity 360ms ease,
            transform 360ms ease;
    }
    .orbit[inert] {
        opacity: 0;
        transform: scale(0.92);
        pointer-events: none;
    }
    .orbit {
        --accent: #61ccba;
        --accent-soft: #9de8d9;
    }
    .orbit[data-side-theme="personal"] {
        --accent: #3b82f6;
        --accent-soft: #93c5fd;
    }

    .orbit-item {
        position: absolute;
        left: 50%;
        top: calc(200 / 410 * 100%);
        translate: -50% -50%;
        transform: translate3d(calc(var(--ox, 0) * var(--u)), calc(var(--oy, 0) * var(--u)), 0);
        will-change: transform;
    }
    .rings {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
    }
    .orbit-item {
        transition: opacity 260ms ease;
    }
    .orbit-item.is-dimmed {
        opacity: 0.28;
    }

    .halo {
        position: absolute;
        inset: calc(-33 * var(--u));
        border-radius: 9999px;
        background: var(--accent);
        opacity: 0.22;
        filter: blur(calc(36 * var(--u)));
    }
    .sun {
        position: relative;
        display: flex;
        width: calc(84 * var(--u));
        height: calc(84 * var(--u));
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border-radius: 9999px;
        /* Glass core: same frosted treatment as the card, so it doesn't compete with the save button. */
        border: 1px solid color-mix(in srgb, var(--accent-soft) 35%, transparent);
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--accent) 28%, transparent),
            color-mix(in srgb, var(--accent) 8%, transparent)
        );
        backdrop-filter: blur(8px);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.15);
        color: var(--accent-soft);
    }
    .sun-label {
        font-family: ui-monospace, "Geist Mono", monospace;
        font-size: max(7px, calc(9 * var(--u)));
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .node,
    .planet {
        display: grid;
        place-items: center;
        color: #f1f1f1;
        -webkit-tap-highlight-color: transparent;
    }
    .chip {
        display: grid;
        width: calc(40 * var(--u));
        height: calc(40 * var(--u));
        place-items: center;
        border-radius: 9999px;
        border: 1px solid rgb(255 255 255 / 0.12);
        background: rgb(255 255 255 / 0.1);
        backdrop-filter: blur(8px);
        transition:
            background 200ms ease,
            transform 200ms ease;
    }
    .node:hover .chip,
    .node:focus-visible .chip {
        background: color-mix(in srgb, var(--accent) 28%, transparent);
        transform: scale(1.06);
    }
    .node:focus-visible,
    .planet:focus-visible,
    .moon:focus-visible {
        outline: 2px solid var(--accent-soft);
        outline-offset: 3px;
        border-radius: 9999px;
    }
    .node-label {
        position: absolute;
        top: calc(100% + 6 * var(--u));
        left: 50%;
        translate: -50% 0;
        white-space: nowrap;
        font-family: ui-monospace, "Geist Mono", monospace;
        font-size: max(8px, calc(10 * var(--u)));
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #f1f1f1;
        pointer-events: none;
    }
    .node-label--above {
        top: auto;
        bottom: calc(100% + 6 * var(--u));
    }

    .planet {
        position: relative;
        width: calc(48 * var(--u));
        height: calc(48 * var(--u));
        border-radius: 9999px;
        border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
        /* Solid, so orbit lines don't show through the planet. */
        background: color-mix(in srgb, var(--accent) 22%, #001414);
        color: var(--accent-soft);
        cursor: pointer;
        transition: transform 200ms ease;
    }
    .planet:active {
        transform: scale(0.94);
    }
    .planet-letter {
        font-size: calc(20 * var(--u));
        font-weight: 700;
    }
    .hint,
    .moon-orbit {
        position: absolute;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        border-radius: 9999px;
        border: 1px dashed rgb(157 232 217 / 0.35);
        pointer-events: none;
        transition:
            opacity 260ms ease,
            scale 260ms ease;
    }
    .hint {
        width: calc(68 * var(--u));
        height: calc(68 * var(--u));
        animation: moons-spin 40s linear infinite;
    }
    @keyframes moons-spin {
        to {
            rotate: 360deg;
        }
    }
    .hint-dot {
        position: absolute;
        width: calc(6 * var(--u));
        height: calc(6 * var(--u));
        translate: -50% -50%;
        border-radius: 9999px;
        background: rgb(157 232 217 / 0.85);
    }
    .moon-orbit {
        width: calc(100 * var(--u));
        height: calc(100 * var(--u));
        opacity: 0;
        scale: 0.6;
    }
    .planet-wrap.is-open .hint {
        opacity: 0;
        scale: 1.3;
    }
    .planet-wrap.is-open .moon-orbit {
        opacity: 1;
        scale: 1;
    }

    .moons {
        position: absolute;
        left: 50%;
        top: 50%;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .moon-slot {
        position: absolute;
        translate: -50% -50%;
        opacity: 0;
        transform: translate(0, 0) scale(0.4);
        pointer-events: none;
        transition:
            transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
            opacity 220ms ease;
    }
    .planet-wrap.is-open .moon-slot {
        opacity: 1;
        transform: translate(calc(var(--mx) * var(--u)), calc(var(--my) * var(--u))) scale(1);
        pointer-events: auto;
    }
    .moon {
        position: relative;
        display: grid;
        width: calc(32 * var(--u));
        height: calc(32 * var(--u));
        place-items: center;
        border-radius: 9999px;
        border: 1px solid rgb(255 255 255 / 0.15);
        background: rgb(0 20 20 / 0.7);
        color: #f1f1f1;
        backdrop-filter: blur(8px);
    }
    /* Invisible 44px tap target around the 32px moon. */
    .moon::after {
        content: "";
        position: absolute;
        inset: max(-6px, calc(22px - 16 * var(--u)));
    }
    /* iOS-style squircle-ish corners. The image is rounded, not clipped by overflow,
       so the 44px tap target around the moon keeps working. */
    .moon--app {
        border-radius: calc(8 * var(--u));
        border-color: rgb(255 255 255 / 0.25);
        background: none;
    }
    .moon--app img {
        width: 100%;
        height: 100%;
        border-radius: inherit;
        object-fit: cover;
    }

    @media (prefers-reduced-motion: reduce) {
        .orbit,
        .orbit-item,
        .moon-slot,
        .hint,
        .moon-orbit {
            transition: none;
        }
        .hint {
            animation: none;
        }
    }
</style>
