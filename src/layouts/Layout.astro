---
import "../styles/global.css";
import { ROBOTS_DIRECTIVES } from "../config/privacy";

interface Props {
    title: string;
    description?: string;
    lang?: "es" | "en";
    noindex?: boolean;
}

const { title, description = "", lang = "en", noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        {
            noindex && (
                <>
                    <meta name="robots" content={ROBOTS_DIRECTIVES} />
                    <meta name="googlebot" content={ROBOTS_DIRECTIVES} />
                    <meta name="bingbot" content={ROBOTS_DIRECTIVES} />
                    <meta name="referrer" content="no-referrer" />
                </>
            )
        }
        <link
            href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
            rel="stylesheet"
        />
        <slot name="head" />
    </head>
    <body class="h-full overflow-hidden text-[#f1f1f1] antialiased">
        <slot />
    </body>
</html>

<style is:global>
    :root {
        font-family: "Satoshi", "Space Grotesk", "Avenir Next", system-ui,
            sans-serif;
    }
    /* The page background sits on the root canvas, not on a fixed layer: iOS Safari
       paints the canvas under its status bar and toolbar, but tints those areas a
       flat colour when the background is a position:fixed element. The document
       never scrolls (main does), so the background stays in place. */
    html {
        height: 100%;
        overflow: hidden;
        background:
            radial-gradient(circle at 20% 0%, rgb(97 204 186 / 0.28), transparent 45%),
            radial-gradient(circle at 80% 70%, rgb(75 152 202 / 0.2), transparent 40%),
            /* Same as drawing bg.svg at 30% opacity over the base colour. */
            linear-gradient(rgb(0 20 20 / 0.7), rgb(0 20 20 / 0.7)),
            url("/bg.svg") center / cover no-repeat,
            #001414;
    }
</style>
