{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "link-pablogamero-com",
  // The Astro Cloudflare adapter fills in "main" and the ASSETS binding at build time.
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "link.pablogamero.com",
      "custom_domain": true,
    },
  ],
}
